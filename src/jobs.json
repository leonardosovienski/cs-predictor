{
  "schema_version": "1",
  "jobs": [
    {
      "id": "cs-archival-collection",
      "command": ["{python}", "-m", "src.scheduler_payload"],
      "timeout_seconds": 900,
      "heartbeat_interval_seconds": 15,
      "max_output_bytes": 1048576,
      "provenance": {"domain": "cs", "mode": "COLLECTION_ONLY"},
      "provenance_mode": "strict",
      "consumer_status": "COLLECTION_ONLY",
      "exit_statuses": {"0": "SUCCEEDED", "2": "SOURCE_UNAVAILABLE"}
    }
  ]
}
